# Tervano Server as a systemd service. Install steps: docs/server-deployment.md ("Linux (systemd)").
[Unit]
Description=Tervano Server
Documentation=https://github.com/Tervano/Tervano/blob/main/docs/server-deployment.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tervano
Group=tervano
# Database and audit archives live here (/var/lib/tervano), created with the right owner.
StateDirectory=tervano
StateDirectoryMode=0750
WorkingDirectory=/var/lib/tervano
ExecStart=/usr/local/bin/tervano-server --config /etc/tervano/server.toml serve
# SIGTERM makes the server stop accepting connections and finish requests (up to 10 s).
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=5
UMask=0077

# Sandbox: the server only needs its state directory, outbound/inbound TCP and its config.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
